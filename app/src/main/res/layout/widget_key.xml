<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60B0C10"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView android:id="@+id/w_lock" style="@style/KeyBtn" android:drawableTop="@drawable/ic_widget_locked" android:text="Lock" />
    <TextView android:id="@+id/w_lights" style="@style/KeyBtn" android:drawableTop="@drawable/ic_shortcut_lights" android:text="Lights" />
    <TextView android:id="@+id/w_ign" style="@style/KeyBtn" android:drawableTop="@drawable/ic_shortcut_start" android:text="Start" />
    <TextView android:id="@+id/w_boot" style="@style/KeyBtn" android:drawableTop="@drawable/ic_shortcut_boot" android:text="Boot" />
</LinearLayout>
