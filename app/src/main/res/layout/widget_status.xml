<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/s_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Creta" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/s_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/s_fuel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/s_fuel_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fuel" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/s_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/s_range_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Range" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/s_odo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/s_odo_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Odometer" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/s_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_fuel_bar" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/s_tyre" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tyres --" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/s_ago" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
