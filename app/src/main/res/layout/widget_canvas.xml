<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_canvas_desc"
        android:scaleType="fitXY" />

    <!-- invisible tap areas for the refresh button the widget draws itself; one is shown depending on the look -->
    <ImageView
        android:id="@+id/w_sync_top"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/widget_refresh" />

    <ImageView
        android:id="@+id/w_sync_mid"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|end"
        android:contentDescription="@string/widget_refresh"
        android:visibility="gone" />
</FrameLayout>
